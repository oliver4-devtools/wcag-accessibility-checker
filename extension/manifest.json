{
  "manifest_version": 3,
  "name": "Oliver4 WCAG Accessibility Checker",
  "short_name": "Oliver4 A11y",
  "version": "1.5.5",
  "description": "WCAG 2.2 A/AA pre-audit aid for Dynamics 365 model-driven apps. A developer aid, not an accessibility audit.",
  "homepage_url": "http://www.oliver4-devtools.com/",
  "minimum_chrome_version": "95",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Oliver4 WCAG Accessibility Checker",
    "default_icon": {
      "16": "icons/oliver4-mark-light-16.png",
      "32": "icons/oliver4-mark-light-32.png",
      "48": "icons/oliver4-mark-light-48.png",
      "128": "icons/oliver4-mark-light-128.png"
    }
  },
  "icons": {
    "16": "icons/oliver4-mark-light-16.png",
    "32": "icons/oliver4-mark-light-32.png",
    "48": "icons/oliver4-mark-light-48.png",
    "128": "icons/oliver4-mark-light-128.png"
  }
}
